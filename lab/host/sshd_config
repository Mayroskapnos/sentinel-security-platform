Port 22
ListenAddress 0.0.0.0
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no
AllowUsers demo-user ops-user admin-demo
PrintMotd no
PrintLastLog no
LogLevel VERBOSE
# The isolated lab generates at most 15 reviewed attempts. Disable OpenSSH's
# source penalty so all bounded attempts produce telemetry within rule windows.
PerSourcePenalties no
PidFile /run/sshd.pid
Subsystem sftp internal-sftp
