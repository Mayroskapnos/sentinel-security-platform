# PostgreSQL development settings. Change these before using any shared environment.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_only_change_me
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_only_change_me@postgres:5432/sentinel

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
TELEMETRY_MAX_BODY_BYTES=262144
SENTINEL_ENV=development
LOG_LEVEL=INFO

# Reserved for the authentication milestone. Generate a unique value before enabling auth.
JWT_SECRET=replace_with_a_random_secret_before_enabling_auth
JWT_ALGORITHM=HS256

# The frontend uses same-origin /api requests by default.
VITE_API_BASE_URL=/api/v1
# Optional explicit socket URL. Leave unset to use the browser's current origin.
# VITE_WS_URL=ws://localhost:8000/api/v1/ws/events
